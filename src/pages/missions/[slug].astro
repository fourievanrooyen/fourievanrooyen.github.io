---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { featuredMissions, site, type Mission } from '@/data/site';

export function getStaticPaths() {
  return featuredMissions.map((mission) => ({ params: { slug: mission.slug }, props: { mission } }));
}

interface Props { mission: Mission }
const { mission } = Astro.props;
const currentIndex = featuredMissions.findIndex((item) => item.slug === mission.slug);
const previous = featuredMissions[(currentIndex - 1 + featuredMissions.length) % featuredMissions.length];
const next = featuredMissions[(currentIndex + 1) % featuredMissions.length];
const title = `${mission.shortTitle} — ${site.name}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: mission.title,
  description: mission.summary,
  url: `${site.url}/missions/${mission.slug}/`,
  creator: { '@type': 'Person', name: site.name, url: site.url },
  about: ['Aerospace engineering', ...mission.tools],
};
---

<BaseLayout title={title} description={mission.summary} canonicalPath={`/missions/${mission.slug}/`} schema={schema} bodyClass="mission-page">
  <article>
    <header class="mission-hero" data-orbit-zone>
      <div class="page-width mission-hero-grid">
        <div data-reveal>
          <a class="text-link" href="/#missions"><span aria-hidden="true">←</span> Mission index</a>
          <div style="margin-top: 34px"><span class="eyebrow">Mission {mission.index} · {mission.eyebrow}</span></div>
          <h1>{mission.shortTitle}</h1>
          <p class="lead">{mission.summary}</p>
          <div class="hero-actions">
            {mission.documents.map((document) => (
              <a class="button primary" href={document.href} target="_blank" rel="noopener">
                {document.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
              </a>
            ))}
            <a class="button" href="#mission-analysis">Review analysis <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="mission-hero-visual" data-reveal>
          <div class="mission-hero-image">
            <ResponsiveImage asset={mission.image} sizes="(max-width: 880px) 100vw, 55vw" loading="eager" fetchpriority="high" />
          </div>
          <div class="mission-readout" aria-label="Mission metadata">
            <div><span>Role</span><b>{mission.role}</b></div>
            <div><span>Organization</span><b>{mission.organization}</b></div>
            <div><span>Window</span><b>{mission.dates}</b></div>
            <div><span>Status</span><b>Documented</b></div>
          </div>
        </div>
      </div>
    </header>

    <section id="mission-analysis" class="case-section" aria-labelledby="challenge-title">
      <div class="page-width case-grid">
        <header class="case-aside" data-reveal>
          <span class="section-index">01 / Challenge</span>
          <h2 id="challenge-title">Mission objective.</h2>
          <p>What the system needed to accomplish—and the engineering boundaries around it.</p>
        </header>
        <div class="case-copy" data-reveal>
          <p>{mission.challenge}</p>
          <p>{mission.summary}</p>
          <ul class="tag-list" aria-label="Tools and methods">{mission.tools.map((tool) => <li>{tool}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="case-section" aria-labelledby="contributions-title">
      <div class="page-width case-grid">
        <header class="case-aside" data-reveal>
          <span class="section-index">02 / Execution</span>
          <h2 id="contributions-title">Engineering contribution.</h2>
          <p>Specific analysis, integration, test, and delivery responsibilities.</p>
        </header>
        <div class="case-copy" data-reveal>
          <ol class="case-list">
            {mission.contributions.map((contribution, index) => <li data-index={String(index + 1).padStart(2, '0')}>{contribution}</li>)}
          </ol>
          {mission.secondaryImage && (
            <div class="case-media">
              <ResponsiveImage asset={mission.secondaryImage} sizes="(max-width: 880px) 100vw, 65vw" />
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="case-section" aria-labelledby="results-title">
      <div class="page-width case-grid">
        <header class="case-aside" data-reveal>
          <span class="section-index">03 / Results</span>
          <h2 id="results-title">Evidence returned.</h2>
          <p>Measured, simulated, or flight-demonstrated outcomes from the supplied records.</p>
        </header>
        <div class="case-copy" data-reveal>
          <div class="case-metrics">
            {mission.metrics.map((metric) => <div class="case-metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
          </div>
          <ol class="case-list">
            {mission.results.map((result, index) => <li data-index={String(index + 1).padStart(2, '0')}>{result}</li>)}
          </ol>
          {mission.documents.length > 0 && (
            <div class="document-actions">
              {mission.documents.map((document) => (
                <a class="button" href={document.href} target="_blank" rel="noopener">
                  {document.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <nav class="mission-nav" aria-label="Mission case studies">
      <a href={`/missions/${previous.slug}/`}><small>Previous mission</small><b>← {previous.shortTitle}</b></a>
      <a href={`/missions/${next.slug}/`}><small>Next mission</small><b>{next.shortTitle} →</b></a>
    </nav>
  </article>

  <script>
    const reveal = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!('IntersectionObserver' in window) || document.documentElement.dataset.motion === 'reduced') {
      reveal.forEach((element) => element.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: .08 });
      reveal.forEach((element) => observer.observe(element));
    }
  </script>
</BaseLayout>
